{
  "expo": {
    "name": "Fuse",
    "slug": "fuse",
    "scheme": "fuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-secure-store",
      "expo-background-task",
      "./plugins/with-supabase-android-trust"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuse.app"
    },
    "android": {
      "package": "com.fuse.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
