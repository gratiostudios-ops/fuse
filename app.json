{
  "expo": {
    "name": "Fuse",
    "slug": "fuse",
    "scheme": "fuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-background-task",
      "./plugins/with-supabase-android-trust"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuse.app"
    },
    "android": {
      "package": "com.fuse.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/app-icon.png"
    },
    "icon": "./assets/app-icon.png"
  }
}
